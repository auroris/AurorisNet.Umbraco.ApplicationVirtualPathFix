<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!--
    The package's dependencies span the supported Umbraco releases, from UmbracoMinimumVersion to UmbracoMaximumVersion
    in Directory.Build.props. NuGet compiles the package against the oldest, which keeps it to APIs every supported
    release has, and a site restores its own release. NuGet accepts any release within the range, so startup also checks
    the site's release against UmbracoReleases. Umbraco.Cms.StaticAssets carries the backoffice scripts the package
    patches, so widen the range only after a release's tests pass.
  -->
  <ItemGroup>
    <PackageVersion Include="Umbraco.Cms.StaticAssets" Version="[$(UmbracoMinimumVersion), $(UmbracoMaximumVersion)]" />
    <PackageVersion Include="Umbraco.Cms.Web.Common" Version="[$(UmbracoMinimumVersion), $(UmbracoMaximumVersion)]" />
  </ItemGroup>
  <!-- The tests' dependencies. The test sites run the Umbraco release in UmbracoVersion. -->
  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <!-- Acornima parses the patched scripts, so a broken replacement fails the quick tests before any browser starts. -->
    <PackageVersion Include="Acornima" Version="1.9.2" />
    <!-- The browser tests save a memory dump of their own process, which hosts the site, when a step fails. -->
    <PackageVersion Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.750501" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
    <PackageVersion Include="Umbraco.Cms" Version="[$(UmbracoVersion)]" />
    <!-- The browser test sites match a project created by `dotnet new umbraco` with the starter kit. -->
    <PackageVersion Include="Umbraco.Cms.DevelopmentMode.Backoffice" Version="[$(UmbracoVersion)]" />
    <PackageVersion Include="Umbraco.TheStarterKit" Version="$(UmbracoStarterKitVersion)" />
  </ItemGroup>
</Project>
