<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
    <PackageId>AurorisNet.Umbraco.ApplicationVirtualPathFix</PackageId>
    <Title>Umbraco Application Virtual Path Fix</Title>
    <!-- The first three numbers are the newest supported Umbraco release, and the release workflow supplies the release
         count. Local packs keep count 0, which is never published, so they cannot shadow a release in NuGet's cache. -->
    <Version>$(UmbracoMaximumVersion).0</Version>
    <Authors>Auroris</Authors>
    <Description>Fixes application virtual path hosting, backoffice assets, media, login and initial token refresh in Umbraco $(UmbracoMinimumVersion) to $(UmbracoMaximumVersion). Registers automatically through Umbraco startup.</Description>
    <PackageTags>umbraco;umbraco-marketplace;virtual-path;backoffice</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <!-- The notes of a release are on its GitHub release, which the Release workflow creates under this tag. -->
    <PackageReleaseNotes>https://github.com/auroris/AurorisNet.Umbraco.ApplicationVirtualPathFix/releases/tag/v$(Version)</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/auroris/AurorisNet.Umbraco.ApplicationVirtualPathFix</PackageProjectUrl>
    <RepositoryUrl>https://github.com/auroris/AurorisNet.Umbraco.ApplicationVirtualPathFix</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Embed the symbols and generated sources in the assembly. Source Link points the symbols at this commit on
         GitHub, so a site's debugger can step into the package. -->
    <DebugType>embedded</DebugType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- The package compiles against the oldest supported Umbraco release, whose own dependencies can carry advisories
         that later releases fixed. A site restores the dependencies of its own Umbraco release, so audit only the
         packages this project references. The test project audits the whole graph of the release it runs. -->
    <NuGetAuditMode>direct</NuGetAuditMode>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AurorisNet.Umbraco.ApplicationVirtualPathFix.Tests" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!--
      Reference the Umbraco packages the package uses rather than the Umbraco.Cms meta-package, so sites that
      assemble Umbraco from individual packages (for example with ImageSharp2) can install it. Directory.Packages.props
      sets their range, which spans the supported releases.
    -->
    <PackageReference Include="Umbraco.Cms.Web.Common" />
    <PackageReference Include="Umbraco.Cms.StaticAssets" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>UmbracoMinimumVersion</_Parameter1>
      <_Parameter2>$(UmbracoMinimumVersion)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>UmbracoMaximumVersion</_Parameter1>
      <_Parameter2>$(UmbracoMaximumVersion)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>UmbracoReleases</_Parameter1>
      <_Parameter2>$(UmbracoReleases)</_Parameter2>
    </AssemblyAttribute>
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Umbraco.Extensions" />
    <!-- nuget.org shows the README with plain Markdown and absolute links only, which README.md keeps to. -->
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="../docs/images/icon.png" Pack="true" PackagePath="/" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
    <Content Update="appsettings-schema*.json;umbraco-package-schema.json" Pack="false" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>
  <!--
    Records this commit's time in the assembly. Patched files use the later of Umbraco's file time and this time as
    Last-Modified, so their cache validators agree across restarts and servers and change with each release. Pass
    -p:SourceTimestamp=2026-11-14T12:00:00Z to set the time, for example when building outside a Git checkout.
  -->
  <Target Name="AddSourceTimestamp" BeforeTargets="GetAssemblyAttributes">
    <!-- %25 is MSBuild's escape for %. On Windows, Exec runs the command from a batch file, where %% is a literal %. -->
    <Exec Condition="'$(SourceTimestamp)' == '' AND '$(OS)' == 'Windows_NT'" Command="git log -1 --format=%25%25cI" EchoOff="true"
          ConsoleToMSBuild="true" IgnoreExitCode="true" ContinueOnError="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="SourceTimestamp" />
    </Exec>
    <Exec Condition="'$(SourceTimestamp)' == '' AND '$(OS)' != 'Windows_NT'" Command="git log -1 --format=%25cI" EchoOff="true"
          ConsoleToMSBuild="true" IgnoreExitCode="true" ContinueOnError="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="SourceTimestamp" />
    </Exec>
    <ItemGroup Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(SourceTimestamp)', '^\d{4}-\d\d-\d\dT[^;]+$'))">
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>SourceTimestamp</_Parameter1>
        <_Parameter2>$(SourceTimestamp)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>
</Project>
