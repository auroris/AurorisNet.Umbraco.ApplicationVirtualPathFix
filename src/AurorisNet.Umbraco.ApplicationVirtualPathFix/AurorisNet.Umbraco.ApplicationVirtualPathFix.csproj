<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <PackageId>AurorisNet.Umbraco.ApplicationVirtualPathFix</PackageId>
    <Title>Umbraco Application Virtual Path Fix</Title>
    <!-- Releases supply the revision; revision 0 is never published, so local packs cannot shadow a release. -->
    <Version>$(UmbracoVersion).0</Version>
    <Authors>Auroris</Authors>
    <Description>Fixes application virtual path hosting, backoffice assets, media, login and initial token refresh in Umbraco $(UmbracoVersion). Registers automatically through Umbraco startup.</Description>
    <PackageTags>umbraco;umbraco-marketplace;virtual-path;backoffice</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/auroris/UmbracoApplicationVirtualPathFix</PackageProjectUrl>
    <RepositoryUrl>https://github.com/auroris/UmbracoApplicationVirtualPathFix</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Symbols travel inside the assembly, and Source Link points them at this repository's commit,
         so a site's debugger can step into the package. Generated sources are embedded as well. -->
    <DebugType>embedded</DebugType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AurorisNet.Umbraco.ApplicationVirtualPathFix.Tests" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!--
      Depend on the parts of Umbraco the package uses rather than the Umbraco.Cms meta-package, so sites
      that assemble Umbraco from individual packages (for example with ImageSharp2) can install it.
      StaticAssets carries the backoffice scripts the package patches, so its exact version is the one
      that matters. The patches must be verified before supporting another Umbraco version.
    -->
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="[$(UmbracoVersion)]" />
    <PackageReference Include="Umbraco.Cms.StaticAssets" Version="[$(UmbracoVersion)]" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>UmbracoVersion</_Parameter1>
      <_Parameter2>$(UmbracoVersion)</_Parameter2>
    </AssemblyAttribute>
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Umbraco.Extensions" />
    <!-- nuget.org renders Markdown only, without HTML or relative links, so the package gets its own README. -->
    <None Include="../../docs/NUGET.md" Pack="true" PackagePath="README.md" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <Content Update="appsettings-schema*.json;umbraco-package-schema.json" Pack="false" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>
  <!--
    Patched files are served with the newer of Umbraco's file time and this commit's time as Last-Modified, so their
    cache validators agree across restarts and servers yet change with each release. Pass SourceTimestamp to override.
  -->
  <Target Name="AddSourceTimestamp" BeforeTargets="GetAssemblyAttributes">
    <!-- cmd reads %% as a literal %; sh does not. -->
    <Exec Condition="'$(SourceTimestamp)' == '' AND '$(OS)' == 'Windows_NT'" Command="git log -1 --format=%25%25cI" EchoOff="true"
          ConsoleToMSBuild="true" IgnoreExitCode="true" ContinueOnError="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="SourceTimestamp" />
    </Exec>
    <Exec Condition="'$(SourceTimestamp)' == '' AND '$(OS)' != 'Windows_NT'" Command="git log -1 --format=%25cI" EchoOff="true"
          ConsoleToMSBuild="true" IgnoreExitCode="true" ContinueOnError="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="SourceTimestamp" />
    </Exec>
    <ItemGroup Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(SourceTimestamp)', '^\d{4}-\d\d-\d\dT[^;]+$'))">
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>SourceTimestamp</_Parameter1>
        <_Parameter2>$(SourceTimestamp)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>
</Project>
